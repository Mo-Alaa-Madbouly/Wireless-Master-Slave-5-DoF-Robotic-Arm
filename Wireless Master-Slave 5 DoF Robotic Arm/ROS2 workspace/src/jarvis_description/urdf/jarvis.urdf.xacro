<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="jarvis">

    <!-- Include Gazebo Parameters -->
    <xacro:include filename="$(find jarvis_description)/urdf/jarvis_gazebo.xacro" />

    <xacro:include filename="$(find jarvis_description)/urdf/jarvis_ros2_control.xacro" />

    <!-- Useful XACRO Variables (Properties) -->
    <xacro:property name="PI" value="3.14159265359" />
    <xacro:property name="effort" value="10.0" />
    <xacro:property name="velocity" value="1.0" />

    <!-- Useful Macros -->
    <xacro:macro name="default_inertial" params="mass">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${mass}" />
            <inertia ixx="1.0" ixy="0.0" ixz="0.0"
                     iyy="1.0" iyz="0.0"
                     izz="1.0" />
        </inertial>
    </xacro:macro>


    <!-- Links -->
    <link name="world"/>

    <link name="base_footprint"/>

    <link name="base_link">
        <xacro:default_inertial mass="0.0948677145004786"/>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://jarvis_description/meshes/base_link.STL"/>
            </geometry>
            <material name="">
                <color rgba="0.298039215686275 0.298039215686275 0.298039215686275 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://jarvis_description/meshes/base_link.STL"/>
            </geometry>
        </collision>
    </link>

    <link name="link1">
        <xacro:default_inertial mass="0.0855344118691868"/>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://jarvis_description/meshes/link1.STL"/>
            </geometry>
            <material name="">
                <color rgba="1 1 1 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://jarvis_description/meshes/link1.STL"/>
            </geometry>
        </collision>
    </link>

    <link name="link2">
        <xacro:default_inertial mass="0.097870598397348"/>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://jarvis_description/meshes/link2.STL"/>
            </geometry>
            <material name="">
                <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://jarvis_description/meshes/link2.STL"/>
            </geometry>
        </collision>
    </link>

    <link name="link3">
        <xacro:default_inertial mass="0.0452899921770384"/>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://jarvis_description/meshes/link3.STL"/>
            </geometry>
            <material name="">
                <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://jarvis_description/meshes/link3.STL"/>
            </geometry>
        </collision>
    </link>

    <link name="link4">
        <xacro:default_inertial mass="0.0852291043276122"/>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://jarvis_description/meshes/link4.STL"/>
            </geometry>
            <material name="">
                <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://jarvis_description/meshes/link4.STL"/>
            </geometry>
        </collision>
    </link>

    <link name="link5">
        <xacro:default_inertial mass="0.0212623199107251"/>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://jarvis_description/meshes/link5.STL"/>
            </geometry>
            <material name="">
                <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://jarvis_description/meshes/link5.STL"/>
            </geometry>
        </collision>
    </link>


    <!-- Joints -->
    <joint name="virtual_joint" type="fixed">
        <parent link="world"/>
        <child link="base_footprint"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <joint name="joint1" type="revolute">
        <parent link="base_link"/>
        <child link="link1"/>
        <origin xyz="-0.023241 -0.0044152 0.039553" rpy="1.5708 0 0"/>
        <axis xyz="0 -1 0"/>
        <limit lower="-${PI / 2}" upper="${PI / 2}" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <joint name="joint2" type="revolute">
        <parent link="link1"/>
        <child link="link2"/>
        <origin xyz="0 0.04028 -0.01391" rpy="-1.5708 1.2851 -1.5708"/>
        <axis xyz="0 0 -1"/>
        <limit lower="-${PI / 2}" upper="${PI / 2}" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <joint name="joint3" type="revolute">
        <parent link="link2"/>
        <child link="link3"/>
        <origin xyz="0 0.15 0" rpy="3.1416 0 -2.8059"/>
        <axis xyz="0 0 1"/>
        <limit lower="-${PI / 2}" upper="${PI / 2}" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <joint name="joint4" type="revolute">
        <parent link="link3"/>
        <child link="link4"/>
        <origin xyz="-0.08818 0 -0.016" rpy="-3.1416 0 1.4092"/>
        <axis xyz="0 0 1"/>
        <limit lower="-${PI / 2}" upper="${PI / 2}" effort="${effort}" velocity="${velocity}"/>
    </joint>

    <!-- joint5 = gripper open/close -->
    <joint name="joint5" type="revolute">
        <parent link="link4"/>
        <child link="link5"/>
        <origin xyz="0.0093207 -0.047445 0.022999" rpy="1.5708 0.14449 -1.8952"/>
        <axis xyz="0 0 1"/>
        <limit lower="0" upper="${PI / 2}" effort="${effort}" velocity="${velocity}"/>
    </joint>

</robot>